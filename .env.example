# Runtime. Production rejects DEVELOPMENT registration and demo mode.
INTERLOCKS_ENV=development
INTERLOCKS_BASE_URL=http://localhost:3000
INTERLOCKS_REGISTRATION_MODE=DEVELOPMENT
INTERLOCKS_DEMO_MODE=true
INTERLOCKS_LOG_LEVEL=debug

# SQLite remains the fully supported local store.
INTERLOCKS_DB_PATH=.data/interlocks.db

# Hosted database deployment path (do not set for local SQLite).
# DATABASE_URL=postgresql://user:password@host:5432/interlocks?sslmode=require

# Replaceable document object store. MVP local implementation: filesystem.
INTERLOCKS_OBJECT_STORE=filesystem
INTERLOCKS_DOCUMENT_PATH=.data/documents

# WorkOS AuthKit. All four values are required in production.
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_...
# WORKOS_COOKIE_PASSWORD=generate-a-random-secret-of-at-least-32-characters
# NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
