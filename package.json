{
  "name": "interlocks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "admin": "node scripts/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**/*.mjs' --test-coverage-lines=99 --test-coverage-branches=88 --test-coverage-functions=98 tests/*.test.mjs",
    "test:http": "node scripts/http-smoke.mjs",
    "test:browser": "node scripts/browser-e2e.mjs",
    "test:all": "npm run lint && npm run test:coverage && npm run build && npm run test:http && npm run validate:artifact",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .data"
  },
  "dependencies": {
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.12.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Interlocks"
}
